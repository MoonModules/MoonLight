Allocate each built-in driver's frame buffers when its init finds the hardware, instead of as statics:
a program carrying both drivers then spends 15 KB on a Teensy 4.1 PHY or 48 KB on a W5500, not both.
Applies after QNEthernet-w5500-bounded-waits.patch, whose include line it borders.

diff --git a/src/qnethernet/drivers/driver_teensy41.cpp b/src/qnethernet/drivers/driver_teensy41.cpp
index 690f490..0b06213 100644
--- a/src/qnethernet/drivers/driver_teensy41.cpp
+++ b/src/qnethernet/drivers/driver_teensy41.cpp
@@ -12,6 +12,7 @@
 
 // C++ includes
 #include <atomic>
+#include <cstdlib>
 #include <cstring>
 
 #include <core_pins.h>
@@ -316,8 +317,10 @@ enum class InitStates {
 // Ethernet buffers
 alignas(64) static BufferDescriptor s_rxRing[kRxSize];
 alignas(64) static BufferDescriptor s_txRing[kTxSize];
-alignas(64) static uint8_t s_rxBufs[kRxSize * kBufSize] BUFFER_DMAMEM;
-alignas(64) static uint8_t s_txBufs[kTxSize * kBufSize] BUFFER_DMAMEM;
+// Allocated when init finds the PHY, so a program that also carries another
+// driver spends them only on a board that has this hardware
+static uint8_t* s_rxBufs = nullptr;
+static uint8_t* s_txBufs = nullptr;
 static volatile BufferDescriptor* s_pRxBD = &s_rxRing[0];
 static volatile BufferDescriptor* s_pTxBD = &s_txRing[0];
 
@@ -953,6 +956,18 @@ FLASHMEM bool init() {
   // Note: The original code left RXD0, RXEN, and RXER with PULLDOWN
   configure_rmii_pins();
 
+  if (s_rxBufs == nullptr) {
+    s_rxBufs = static_cast<uint8_t*>(aligned_alloc(64, kRxSize * kBufSize));
+    s_txBufs = static_cast<uint8_t*>(aligned_alloc(64, kTxSize * kBufSize));
+    if (s_rxBufs == nullptr || s_txBufs == nullptr) {
+      std::free(s_rxBufs);
+      std::free(s_txBufs);
+      s_rxBufs = nullptr;
+      s_txBufs = nullptr;
+      return false;
+    }
+  }
+
   (void)std::memset(s_rxRing, 0, sizeof(s_rxRing));
   (void)std::memset(s_txRing, 0, sizeof(s_txRing));
   s_pRxBD = &s_rxRing[0];
