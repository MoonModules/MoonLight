-// Sends a socket command and ensures it completes.
+// A chip that stops answering costs a frame, never the device: every wait on
+// it ends after this long, counted and reported.
+static constexpr uint32_t kChipWaitUs = 20000;
+static uint32_t s_chipTimeouts = 0;
+
+static void chipTimedOut(const char* what) {
+  static uint32_t lastReport = 0;
+  ++s_chipTimeouts;
+  if (millis() - lastReport >= 1000) {
+    lastReport = millis();
+    printf("W5500: %s timed out (%lu so far)\n", what,
+           static_cast<unsigned long>(s_chipTimeouts));
+  }
+}
+
+// Sends a socket command and waits, bounded, for it to complete.
