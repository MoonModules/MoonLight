      "op": "add_module",
      "id": "MULT",
      "type": "MultiplyModifier",
      "parent_id": "Layer"
    },
    {
      "name": "fix-drivers",
      "op": "add_module",
      "id": "Drivers",
      "type": "Drivers",
      "props": {
        "effects": "Effects"
      }
    },
    {
      "name": "fix-artnet",
      "op": "add_module",
      "id": "Preview",
      "type": "PreviewDriver",
      "parent_id": "Drivers",
      "description": "An in-process sink, not a network one: this scenario is about how a modifier CHAIN folds, and routing it through NetworkSendDriver pulled socket behavior into a test that is not about the network (CodeRabbit #29). PreviewDriver consumes the composite in memory."
    }
