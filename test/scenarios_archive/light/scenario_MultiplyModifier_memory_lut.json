{
  "name": "scenario_MultiplyModifier_memory_lut",
  "module": "MultiplyModifier",
  "mode": "construct",
  "also": [
    "Layer",
    "MappingLUT",
    "BlendMap"
  ],
  "description": "Verify that adding a MultiplyModifier allocates both the mapping LUT and the driver buffer (the heavy memory path). Companion to scenario_Layer_memory_1to1, which verifies the no-LUT path.",
  "steps": [
    {
      "name": "add-layout-group",
      "description": "Create the top-level Layouts container.",
      "op": "add_module",
      "id": "Layouts",
      "type": "Layouts"
    },
    {
      "name": "add-grid",
      "description": "Add a 16x16 GridLayout.",
      "op": "add_module",
      "id": "Grid",
      "type": "GridLayout",
      "parent_id": "Layouts",
      "props": {
        "width": 16,
        "height": 16
      }
    },
    {
      "name": "add-layer",
      "description": "Add a Layer wired to Layouts (RGB).",
      "op": "add_module",
      "id": "Layer",
      "type": "Layer",
      "props": {
        "layouts": "Layouts",
        "channelsPerLight": 3
      }
    },
    {
      "name": "add-noise",
      "description": "Add NoiseEffect as the Layer's effect.",
      "op": "add_module",
      "id": "Noise",
      "type": "NoiseEffect",
      "parent_id": "Layer"
    },
    {
      "name": "add-mirror",
      "description": "Add MultiplyModifier, triggers LUT and driver-buffer allocation.",
      "op": "add_module",
      "id": "Multiply",
      "type": "MultiplyModifier",
      "parent_id": "Layer"
    },
    {
      "name": "add-driver-group",
      "description": "Add a Drivers container wired to the Layer.",
      "op": "add_module",
      "id": "Drivers",
      "type": "Drivers",
      "props": {
        "layer": "Layer"
      }
    },
    {
      "name": "add-artnet",
      "description": "Add NetworkSendDriver and run the bounded FPS measurement on the LUT path.",
      "op": "add_module",
      "id": "ArtNet",
      "type": "NetworkSendDriver",
      "parent_id": "Drivers",
      "measure": true,
      "bounds": {
        "fps": {
          "min_pct": 80
        }
      },
      "contract": {
        "desktop-macos": {
          "tick_us": 120,
          "free_heap": 0,
          "set_by": "2026-06-02",
          "reason": "initial contract"
        }
      },
      "observed": {
        "desktop-macos": {
          "tick_us": {
            "p50": 3,
            "p95": 3,
            "min": 2,
            "max": 17,
            "n": 32,
            "samples": [2, 3, 3, 3, 3, 3, 2, 2, 3, 3, 3, 3, 2, 3, 3, 3, 3, 2, 3, 3, 2, 3, 3, 3, 3, 2, 3, 3, 2, 17, 3, 3]
          },
          "last_updated": "2026-09-24"
        },
        "desktop-windows": {
          "tick_us": {
            "p50": 3,
            "p95": 3,
            "min": 3,
            "max": 3,
            "n": 1,
            "samples": [3]
          },
          "last_updated": "2026-08-23"
        }
      }
    }
  ]
}
