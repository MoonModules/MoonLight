    {
      "name": "add-parallel-driver",
      "description": "One ParallelLedDriver on lane 0, 64 LEDs (i80 rounds the bus up to 8 pins and parks the spare lanes; the 8-pin set is the S3's clean range). The peripheral is set per switch step below.",
      "op": "apply_state",
      "document": {
        "Drivers": {
          "ParallelLed": {
            "type": "ParallelLedDriver",
            "pins": "1,2,3,4,5,6,7,8",
            "ledsPerPin": "64,0,0,0,0,0,0,0"
          }
        }
      }
    },
    {
      "name": "switch-i80",
      "description": "Select the IDF-backed peripheral, named LCD-IDF on a chip whose esp_lcd backend is LCD_CAM (S3, P4, S31). A classic ESP32 names the same backend I2S-IDF and skips this ladder, since one unavailable value takes the module out of the run: covering classic needs its own scenario rather than a step here.",
      "op": "set_control",
      "id": "ParallelLed",
      "key": "peripheral",
      "value": "LCD-IDF",
      "optional": true
    },
