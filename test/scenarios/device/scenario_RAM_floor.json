{
  "name": "scenario_RAM_floor",
  "module": "SystemModule",
  "also": [
    "HttpServerModule",
    "TasksModule",
    "BouncingBallsEffect",
    "Layer"
  ],
  "mode": "mutate",
  "live_only": true,
  "description": "Internal RAM, the largest free block and the tightest task stack, with the board's own layout and drivers and one fixed effect: idle, with the UI open in a real browser, after a refresh, and after it closes. A board with PSRAM keeps 100 KB of internal RAM free and a 50 KB block through all four, the floor WiFi, HTTP and the UI need; a board without PSRAM is recorded but holds no floor, since its network buffers share the same RAM. Only the effects are replaced, so a board's LED driver, the largest internal RAM user, stays as it runs.",
  "top": [
    "Effects"
  ],
  "steps": [
    {
      "name": "effects-clear",
      "op": "apply_state",
      "document": {
        "Effects": {
          "$patch": "replace"
        }
      }
    },
    {
      "name": "fixed-effect",
      "description": "BouncingBalls, the effect the internal RAM plan measured every A/B on.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "type": "Layer",
            "BouncingBalls": {
              "type": "BouncingBallsEffect"
            }
          }
        }
      }
    },
    {
      "name": "idle",
      "description": "No browser on the board.",
      "op": "measure",
      "contract": {
        "esp32s3-n16r8": {
          "free_internal": 102400,
          "max_alloc_block": 51200,
          "min_stack_free": 256,
          "heap_tolerance_pct": 0,
          "set_by": "2026-10-22",
          "reason": "the internal RAM plan's floor: 100 KB free and a 50 KB block, and no task within 256 bytes of its stack's end, ESP-IDF's own ipc tasks running at about 500"
        },
        "esp32p4rev1-eth": {
          "free_internal": 102400,
          "max_alloc_block": 51200,
          "min_stack_free": 256,
          "heap_tolerance_pct": 0,
