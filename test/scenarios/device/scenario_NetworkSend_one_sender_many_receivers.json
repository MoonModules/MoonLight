{
  "name": "scenario_NetworkSend_one_sender_many_receivers",
  "module": "NetworkSendDriver",
  "also": [
    "NetworkReceiveEffect"
  ],
  "mode": "mutate",
  "live_only": true,
  "boards": [
    "sender",
    "receiver2"
  ],
  "description": "One sender, two receivers: Network Send splits a grid over this device and receiver2 by unicast DDP, then sends one stream both take, by Art-Net broadcast and E1.31 multicast. Each receiver reports Network Receive's tick and its packets and frames per second against the sender's frame rate.",
  "top": [
    "Layouts",
    "Effects",
    "Drivers"
  ],
  "steps": [
    {
      "name": "sender-clear-layouts",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "$patch": "replace"
        }
      },
      "description": "The sender's canvas: one grid, one layer with a changing effect, and a Network Send aimed at both receivers.",
      "device": "sender"
    },
    {
      "name": "sender-clear-effects",
      "op": "apply_state",
      "document": {
        "Effects": {
          "$patch": "replace"
        }
      },
      "device": "sender"
    },
    {
      "name": "sender-grid",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "Grid": {
            "type": "GridLayout",
            "width": 64,
            "height": 64
          }
        }
      },
      "device": "sender"
    },
    {
      "name": "sender-layer",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "type": "Layer",
            "Rainbow": {
              "type": "RainbowEffect"
            }
          }
        }
      },
      "device": "sender"
    },
    {
      "name": "sender-send",
      "op": "apply_state",
      "document": {
        "Drivers": {
          "Send": {
            "type": "NetworkSendDriver",
            "hosts": "{host},{receiver2}",
            "protocol": 2,
            "fps": 40
          }
        }
      },
      "device": "sender"
    },
    {
      "name": "host-clear-layouts",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "$patch": "replace"
        }
      },
      "description": "A receiver's canvas: one grid and one layer holding Network Receive."
    },
    {
      "name": "host-clear-effects",
      "op": "apply_state",
      "document": {
        "Effects": {
          "$patch": "replace"
        }
      }
    },
    {
      "name": "host-grid",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "Grid": {
            "type": "GridLayout",
            "width": 64,
            "height": 32
          }
        }
      }
    },
    {
      "name": "host-layer",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "type": "Layer",
            "NetworkReceive": {
              "type": "NetworkReceiveEffect"
            }
          }
        }
      }
    },
