    {
      "name": "a-wrong-control-is-named",
      "description": "The first failure comes back with where it is, so a client can show the user what to fix.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "Doc": {
              "nope": 1
            }
          }
        }
      },
      "error": "no such control",
      "at": "Effects.Layer.Doc.nope"
    },
    {
      "name": "every-card-applies-back",
      "description": "Every card read back as its document, sent as one: what the device shows applies as it is.",
      "op": "round_trip_state"
    }
  ],
  "reset": [
    {
      "name": "leave-no-effect-behind",
      "description": "null removes an effect a previous run left behind, so a run starts from the same tree.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "Doc": null
          }
        }
      }
    }
  ]
