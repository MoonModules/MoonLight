{
  "name": "scenario_State_one_document_adds_an_effect_with_its_controls",
  "module": "HttpServerModule",
  "mode": "mutate",
  "also": [
    "Effects",
    "Layer",
    "RainbowEffect"
  ],
  "description": "A state document sets any part of the device's state in one request: here an effect with its controls, under a layer, where adding it module by module took one request for the module and one per control. A document that names a control the effect lacks is refused with the reason and the place.",
  "fixture": [
    {
      "name": "fix-layouts",
      "op": "add_module",
      "id": "Layouts",
      "type": "Layouts"
    },
    {
      "name": "fix-grid",
      "op": "add_module",
      "id": "Grid",
      "type": "GridLayout",
      "parent_id": "Layouts",
      "props": {
        "width": 16,
        "height": 16
      }
    },
    {
      "name": "fix-effects",
      "op": "add_module",
      "id": "Effects",
      "type": "Effects",
      "props": {
        "layouts": "Layouts"
      }
    },
    {
      "name": "fix-layer",
      "op": "add_module",
      "id": "Layer",
      "type": "Layer",
      "parent_id": "Effects",
      "props": {
        "layouts": "Layouts"
      }
    },
    {
      "name": "fix-drivers",
      "op": "add_module",
      "id": "Drivers",
      "type": "Drivers",
      "props": {
        "effects": "Effects"
      }
    }
  ],
  "steps": [
    {
      "name": "one-document",
      "description": "The effect and its control in one document, as PATCH /api/state takes it.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "Doc": {
              "type": "RainbowEffect",
              "speed": 90
            }
          }
        }
      }
    },
    {
      "name": "it-runs-with-its-control",
      "op": "expect_control",
      "id": "Doc",
      "key": "speed",
      "equals": "90"
    },
    {
      "name": "measure-it",
      "op": "measure",
      "measure": true,
      "observed": {
        "desktop-macos": {
          "tick_us": {
