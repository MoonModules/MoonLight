{
  "name": "scenario_AccessPoint_protected_and_always_on",
  "module": "AccessPointModule",
  "mode": "mutate",
  "also": [
    "NetworkModule"
  ],
  "on_request": true,
  "host_network": true,
  "description": "The access point opened always on a device that stays on its network, protected by the first known network's password. This computer joins it with that password and finds that a client there receives no stored password and no config file, while the same requests from the home network do. It takes the computer off its network for a minute, so it runs only when named, with --network naming the moondeck.json network the device is on.",
  "steps": [
    {
      "name": "opens-always",
      "op": "set_control",
      "id": "AccessPoint",
      "key": "opens",
      "value": 1
    },
    {
      "name": "join-it-with-the-home-password",
      "op": "host_wifi",
      "join": "access_point",
      "password": "{network.password}",
      "timeout": 60
    },
    {
      "name": "still-on-its-network",
      "op": "expect_control",
      "id": "Network",
      "key": "mode",
      "equals": "WiFi STA"
    },
    {
      "name": "this-computer-is-on-it",
      "op": "expect_control",
      "id": "AccessPoint",
      "key": "clients",
      "not_equals": "0",
      "within": 10
    },
    {
      "name": "no-stored-password-through-it",
      "op": "expect_http",
      "url": "/api/state",
      "status": 200,
      "body_lacks": "\"type\":\"password\",\"value\":\"[^\"]"
    },
    {
      "name": "no-config-file-through-it",
      "op": "expect_http",
      "url": "/api/file?path=/.config/NetworkModule.json",
      "status": 403
    },
    {
      "name": "home",
      "op": "host_wifi",
      "join": "home",
      "timeout": 90
    },
    {
      "name": "at-home-the-password-shows",
      "op": "expect_http",
      "url": "/api/state",
      "status": 200,
      "body_matches": "\"type\":\"password\",\"value\":\"[^\"]"
    },
    {
      "name": "at-home-the-config-file-reads",
      "op": "expect_http",
      "url": "/api/file?path=/.config/NetworkModule.json",
      "status": 200
    },
    {
      "name": "on-failure-again",
      "op": "set_control",
      "id": "AccessPoint",
      "key": "opens",
      "value": 0
    }
  ]
}
