    {
      "name": "master-off",
      "description": "The master switch blacks the output without touching brightness, so toggling back restores the level.",
      "op": "set_control",
      "id": "Drivers",
      "key": "on",
      "value": false
    },
    {
      "name": "it-is-off",
      "op": "expect_control",
      "id": "Drivers",
      "key": "on",
      "equals": "false"
    },
    {
      "name": "the-level-was-kept",
      "description": "Brightness is untouched by the switch, which is why toggling back does not lose the setting.",
      "op": "expect_control",
      "id": "Drivers",
      "key": "brightness",
      "equals": "180"
    },
    {
      "name": "master-on",
      "op": "set_control",
      "id": "Drivers",
      "key": "on",
      "value": true
    },
    {
      "name": "restart",
      "description": "Restart: an installation's brightness is set once and expected to stay.",
      "op": "reboot",
      "timeout": 60
