{
  "name": "scenario_Drivers_output_and_brightness",
  "module": "Drivers",
  "mode": "mutate",
  "also": [
    "PreviewDriver",
    "FixtureProfilesModule"
  ],
  "description": "How a finished frame leaves the device. The global brightness and the master switch are the two controls every installation touches, and both must apply on the next frame rather than at the next boot. Brightness defaults low so a fresh board on USB cannot brown out at full white, which is a safety default worth pinning.",
  "top": [
    "Layouts",
    "Effects",
    "Drivers"
  ],
  "reset": [
    {
      "name": "reset-brightness",
      "description": "The boot default, so this scenario measures from where a fresh device starts.",
      "op": "set_control",
      "id": "Drivers",
      "key": "brightness",
      "value": 20
    },
    {
      "name": "reset-on",
      "op": "set_control",
      "id": "Drivers",
      "key": "on",
      "value": true
    }
  ],
  "fixture": [
    {
      "name": "grid",
      "description": "A 16x16 panel, small enough to run anywhere.",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "Grid": {
            "type": "GridLayout",
            "width": 16,
            "height": 16
          }
        }
      }
    },
    {
      "name": "layer",
      "description": "One layer over those layouts: what the drivers read, and what carries the light brightness scales.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "type": "Layer"
          }
        }
      }
    },
    {
      "name": "effect",
      "description": "An effect that paints from the first frame, so there is output to dim.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "FX": {
              "type": "RainbowEffect"
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "name": "brightness-starts-low",
      "description": "A fresh device is dim on purpose: full white on USB 5V browns a board out. The reset block above is what makes this readable after another scenario has run.",
      "op": "expect_control",
      "id": "Drivers",
      "key": "brightness",
      "equals": "20"
    },
    {
      "name": "turn-it-up",
      "description": "What a user does once the board is powered properly.",
      "op": "set_control",
      "id": "Drivers",
      "key": "brightness",
      "value": 180
    },
    {
      "name": "it-took",
      "op": "expect_control",
      "id": "Drivers",
      "key": "brightness",
      "equals": "180"
    },
    {
