{
  "name": "scenario_Layouts_resize_reallocates_live",
  "module": "GridLayout",
  "mode": "mutate",
  "also": [
    "Layouts",
    "Layer"
  ],
  "description": "Changing where the lights are, while they are running. Every control applies on the next frame, so a resize reallocates the buffer under a rendering pipeline rather than after a reboot.",
  "fixture": [
    {
      "name": "layouts",
      "description": "The container the layouts live in, which the layer reads its coordinates from.",
      "op": "add_module",
      "id": "Layouts",
      "type": "Layouts"
    },
    {
      "name": "grid",
      "description": "The panel this scenario resizes, at the size a fresh one starts on.",
      "op": "add_module",
      "id": "Grid",
      "type": "GridLayout",
      "parent_id": "Layouts",
      "props": {
        "width": 16,
        "height": 16
      }
    },
    {
      "name": "layer",
      "description": "One layer over those layouts, which is what owns the buffer a resize has to reallocate.",
      "op": "add_module",
      "id": "Layer",
      "type": "Layer",
      "props": {
        "layouts": "Layouts"
      }
    },
    {
      "name": "effect",
      "description": "An effect that paints from the first frame, so the buffer carries light rather than zeros.",
      "op": "add_module",
      "id": "FX",
      "type": "RainbowEffect",
      "parent_id": "Layer"
    },
    {
      "name": "drivers",
      "description": "The drivers container, wired to the effects whose buffer it reads.",
      "op": "add_module",
      "id": "Drivers",
      "type": "Drivers",
      "props": {
        "layer": "Layer"
      }
    },
    {
      "name": "preview",
      "description": "The preview is a driver like any other, and the one every target has.",
      "op": "add_module",
      "id": "Preview",
      "type": "PreviewDriver",
      "parent_id": "Drivers"
    }
  ],
  "steps": [
