    {
      "name": "grid",
      "description": "The panel this scenario resizes, at the size a fresh one starts on.",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "Grid": {
            "type": "GridLayout",
            "width": 16,
            "height": 16
          }
        }
      }
    },
    {
      "name": "layer",
      "description": "One layer over those layouts, which is what owns the buffer a resize has to reallocate.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "type": "Layer"
          }
        }
      }
    },
    {
      "name": "effect",
      "description": "An effect that paints from the first frame, so the buffer carries light rather than zeros.",
