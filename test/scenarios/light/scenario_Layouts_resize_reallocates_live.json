{
  "name": "scenario_Layouts_resize_reallocates_live",
  "module": "GridLayout",
  "mode": "mutate",
  "also": [
    "Layouts",
    "Layer"
  ],
  "description": "Changing where the lights are, while they are running. Every control applies on the next frame, so a resize reallocates the buffer mid-render rather than asking for a reboot: this walks the grid up and back down, measuring each, so the cost of a size is the difference between two steps.",
  "fixture": [
    {
      "name": "fix-Layouts",
      "op": "add_module",
      "id": "Layouts",
      "type": "Layouts"
    },
    {
      "name": "fix-Grid",
      "op": "add_module",
      "id": "Grid",
      "type": "GridLayout",
      "parent_id": "Layouts"
    }
  ],
  "steps": [
    {
      "name": "small",
      "description": "A 16x16 panel, the size a device boots with.",
      "op": "set_control",
      "id": "Grid",
      "key": "width",
      "value": 16
    },
    {
      "name": "small-height",
      "op": "set_control",
      "id": "Grid",
      "key": "height",
      "value": 16
    },
    {
      "name": "measure-small",
      "op": "measure",
      "measure": true,
      "observed": {
        "desktop-macos": {
          "tick_us": {
            "p50": 26,
            "p95": 148,
            "min": 1,
            "max": 207,
            "n": 24,
            "samples": [43, 47, 65, 17, 55, 27, 19, 41, 27, 55, 45, 20, 15, 21, 148, 207, 21, 28, 23, 22, 22, 21, 26, 1]
          },
          "last_updated": "2026-09-29"
        }
      }
    },
    {
      "name": "grow",
      "description": "Four times the lights, which is where a reallocation would fail if one were going to.",
      "op": "set_control",
      "id": "Grid",
      "key": "width",
      "value": 32
    },
    {
      "name": "grow-height",
      "op": "set_control",
      "id": "Grid",
      "key": "height",
      "value": 32
    },
    {
      "name": "measure-grown",
      "op": "measure",
      "measure": true,
      "observed": {
        "desktop-macos": {
          "tick_us": {
            "p50": 66,
            "p95": 229,
            "min": 33,
            "max": 1358,
            "n": 23,
            "samples": [71, 77, 94, 42, 92, 64, 33, 66, 1358, 97, 89, 91, 106, 53, 147, 229, 36, 44, 44, 44, 33, 36, 34]
          },
          "last_updated": "2026-09-29"
        }
      }
