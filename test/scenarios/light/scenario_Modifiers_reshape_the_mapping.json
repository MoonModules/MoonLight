{
  "name": "scenario_Modifiers_reshape_the_mapping",
  "mode": "mutate",
  "description": "A modifier changes where an effect's pixels land, not what it draws. Stacking, reordering and removing them rebuilds the mapping under a running pipeline, and a layer with no modifier at all must stay on the identity path rather than paying for a lookup table it does not need.",
  "also": [
    "Layer",
    "MultiplyModifier",
    "CheckerboardModifier"
  ],
  "fixture": [
    {
      "name": "layouts",
      "description": "Where the lights are, which the layer reads its coordinates from.",
      "op": "add_module",
      "id": "Layouts",
      "type": "Layouts"
    },
    {
      "name": "grid",
      "description": "A 16x16 panel, small enough to run anywhere and square so a mirror is visible in the mapping.",
      "op": "add_module",
      "id": "Grid",
      "type": "GridLayout",
      "parent_id": "Layouts",
      "props": {
        "width": 16,
        "height": 16
      }
    },
    {
      "name": "layer",
      "description": "One layer over those layouts, which owns the mapping a modifier reshapes.",
      "op": "add_module",
      "id": "Layer",
      "type": "Layer",
      "props": {
        "layouts": "Layouts"
      }
    },
    {
      "name": "effect",
      "description": "An effect that paints from the first frame, so a change in mapping is a change in something real.",
      "op": "add_module",
      "id": "FX",
      "type": "RainbowEffect",
      "parent_id": "Layer"
    },
    {
      "name": "drivers",
      "description": "The drivers container, wired to the effects whose buffer it reads.",
      "op": "add_module",
      "id": "Drivers",
      "type": "Drivers",
      "props": {
        "layer": "Layer"
      }
    },
    {
      "name": "preview",
      "description": "The preview is a driver like any other, and the one every target has.",
      "op": "add_module",
      "id": "Preview",
      "type": "PreviewDriver",
      "parent_id": "Drivers"
    }
  ],
