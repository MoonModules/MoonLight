{
  "name": "scenario_Effects_teardown_under_a_running_pipeline",
  "mode": "mutate",
  "instances": {
    "Grid": "GridLayout",
    "Preview": "PreviewDriver"
  },
  "description": "Removing modules while the lights are still rendering. A module that is taken away mid-frame must leave the pipeline running on whatever it can still reach, rather than following a pointer to something that is gone.",
  "also": [
    "Effects",
    "Services",
    "AudioService"
  ],
  "top": [
    "Layouts",
    "Effects",
    "Drivers",
    "Services"
  ],
  "fixture": [
    {
      "name": "grid",
      "description": "A 16x16 panel: small enough to run anywhere, and every light is one the teardown could strand.",
      "op": "apply_state",
      "document": {
        "Layouts": {
          "Grid": {
            "type": "GridLayout",
            "width": 16,
            "height": 16
          }
        }
      }
    },
    {
      "name": "layer",
      "description": "One layer over those layouts, which owns the buffer every check below reads.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "type": "Layer"
          }
        }
      }
    },
    {
      "name": "effect",
      "description": "An effect that paints from the first frame, so the pipeline is genuinely running before anything is removed.",
      "op": "apply_state",
      "document": {
        "Effects": {
          "Layer": {
            "FX": {
              "type": "RainbowEffect"
            }
          }
        }
      }
    }
  ],
