{
  "name": "95-add-a-layer",
  "description": "A second layer, and what blending actually means.",
  "steps": [
    {
      "action": "chapter",
      "title": "Add a layer",
      "description": "Blending happens between layers",
      "seconds": 1.8
    },
    {
      "action": "open_card",
      "module": "Effects",
      "hold": 0.6
    },
    {
      "action": "clear_children",
      "module": "Layer"
    },
    {
      "action": "add_module",
      "parent": "Layer",
      "type": "BouncingBallsEffect",
      "as": "balls",
      "hold": 1.0
    },
    {
      "action": "add_module",
      "parent": "Effects",
      "type": "Layer",
      "as": "layer2",
      "caption": "Blending is between LAYERS: add a second one.",
      "hold": 1.6
    },
    {
      "action": "add_module",
      "parent": "{layer2}",
      "type": "RipplesEffect",
      "as": "ripples",
      "caption": "Its own effect, painting into its own buffer.",
      "hold": 1.8
    },
    {
      "action": "drag_slider",
      "module": "{layer2}",
      "control": "opacity",
      "to": 0.45,
      "seconds": 2.2,
      "caption": "The drivers composite the layers bottom to top: opacity sets how much of this one shows.",
      "hold": 2.4,
      "expect": {
        "module": "{layer2}",
        "control": "opacity",
        "value": 115
      }
    },
    {
      "action": "delete_module",
      "module": "{layer2}"
    },
    {
      "action": "delete_module",
      "module": "{balls}"
    }
  ]
}
