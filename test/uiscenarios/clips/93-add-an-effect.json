{
  "name": "93-add-an-effect",
  "description": "Add an effect to a layer and drive its controls.",
  "steps": [
    {
      "action": "chapter",
      "title": "Add an effect",
      "description": "Something to paint the lights",
      "seconds": 1.8
    },
    {
      "action": "open_card",
      "module": "Effects",
      "caption": "A layer holds the effects that paint those lights.",
      "hold": 0.8
    },
    {
      "action": "clear_children",
      "module": "Layer",
      "caption": "One effect per layer: start from a clean one.",
      "hold": 1.0
    },
    {
      "action": "add_module",
      "parent": "Layer",
      "type": "BouncingBallsEffect",
      "as": "balls",
      "caption": "Add Bouncing Balls to the layer.",
      "hold": 1.4
    },
    {
      "action": "drag_slider",
      "module": "{balls}",
      "control": "numBalls",
      "to": 0.5,
      "seconds": 2.0,
      "caption": "Every control is live. There is no apply button.",
      "hold": 0.8
    },
    {
      "action": "drag_slider",
      "module": "{balls}",
      "control": "grav",
      "to": 0.65,
      "seconds": 2.0,
      "hold": 1.2
    },
    {
      "action": "delete_module",
      "module": "{balls}"
    }
  ]
}
