<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The network the program serves and drives fixtures on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS, Art-Net broadcast and the presence packets are multicast, which Android drops without this lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The effects keep running with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Firmware card installs the next release's APK over this one, which Android lets an app do once the person allows it to install apps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The Audio card's microphone, asked for the first time the app opens. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="MoonLight"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <!-- The window a freeform system opens it at, a headset's panel or a desktop-mode tablet: landscape and wide, the size a laptop shows MoonLight at, and resizeable. A phone ignores it. -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:gravity="center" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- connectedDevice: the type Android names for an app talking to devices over the network, which is what MoonLight does; microphone, so the Audio card hears the room with the screen off too. -->
        <service
            android:name=".MoonLightService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- The installer's answer to an update this app committed (Updater.kt), and the service started again once Android replaced the app. -->
        <receiver android:name=".InstallStatus" android:exported="false" />
        <receiver android:name=".PackageReplaced" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
