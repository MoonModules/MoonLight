#!/bin/sh
# moonlight.service's ExecStopPost: the previous program back when a new one fails before it has proved itself. The swap leaves MoonLight.pending
# beside the new program, which deletes it after a minute up (systemd's boot assessment, for one program); a confirmed program that fails later
# fails for another reason, which the previous one would only hide. Restart= starts the service again after this.
set -eu
# A clean stop, and a stop that outran TimeoutStopSec: a program that ran, not one that failed to start.
case "${SERVICE_RESULT:-}" in success|timeout) exit 0 ;; esac
bin=/var/lib/moonlight/bin
[ -f "$bin/MoonLight.pending" ] && [ -f "$bin/MoonLight.prev" ] || exit 0
mv -f "$bin/MoonLight.prev" "$bin/MoonLight"
rm -f "$bin/MoonLight.pending"
echo "moonlight: the new program failed to start, the previous one is back"
