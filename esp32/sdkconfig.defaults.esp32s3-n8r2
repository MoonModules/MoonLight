# ESP32-S3-N8R2: 8 MB flash, 2 MB QUAD PSRAM. The Adafruit MatrixPortal S3 carries one.
# Append to sdkconfig.defaults (later fragment wins).
#
# Its own variant rather than a reuse of the other S3 images: the N8R8/N16R8 images set
# SPIRAM_MODE_OCT, and an octal-mode binary fails PSRAM init on quad hardware, while the S3-Zero
# image boots here but uses half the flash. Board pins (HUB75, buttons, status LED) are runtime
# config from deviceModels.json, so this one image serves every N8R2 board.

# The 8 MB flash and its MoonBase partition table: a factory recovery image, ONE 3 MB app slot,
# and 4 MB of LittleFS, where the S3-Zero's 4 MB table affords a 2496 KB slot and 548 KB of
# filesystem.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/8mb_moonbase.csv"

# Quad I/O flash reads, as on the N16R8, where reading code over two lines (DIO, the IDF default) cost 16% of the tick.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM: 2 MB, QUAD mode. Not SPIRAM_MODE_OCT, which the N8R8/N16R8 images use for their octal
# parts. Quad leaves GPIO 35 to 37 free, which the MatrixPortal routes to HUB75 lines.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# At the 80 MHz the part is rated for rather than IDF's 40 MHz default.
CONFIG_SPIRAM_SPEED_80M=y

# MoonLive native codegen needs an executable heap (allocExec -> MALLOC_CAP_EXEC IRAM).
# MALLOC_CAP_EXEC is gated behind CONFIG_HEAP_HAS_EXEC_HEAP, which IDF disables whenever
# memory protection (PMP/PMS W^X) is on. A JIT fundamentally needs writable-then-executable
# memory, so disable memprot (which enables the exec heap). Same configuration as the other
# S3 images; safety for scripted code is the staged bounds/watchdog checks, not the
# hardware W^X wall.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_HEAP_HAS_EXEC_HEAP=y
