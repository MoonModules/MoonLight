# ESP32-S3 with QUAD PSRAM: the S3-Zero (N4R2) and the N8R2 (the Adafruit MatrixPortal S3 carries one).
# Append to sdkconfig.defaults (later fragment wins); the flash size and partition table come from the
# moonbase-4mb or moonbase-8mb fragment layered on top.
#
# The N8R8/N16R8 images set SPIRAM_MODE_OCT, and an octal-mode binary does not merely under-perform on
# quad hardware, it fails PSRAM init at boot. Quad also leaves GPIO 35 to 37 free, which the MatrixPortal
# routes to HUB75 lines.

# Quad I/O flash reads, as on the N16R8, where reading code over two lines (DIO, the IDF default) cost 16% of the tick.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM: 2 MB, QUAD mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# At the 80 MHz the part is rated for rather than IDF's 40 MHz default.
CONFIG_SPIRAM_SPEED_80M=y

# MoonLive native codegen needs an executable heap (allocExec -> MALLOC_CAP_EXEC IRAM).
# MALLOC_CAP_EXEC is gated behind CONFIG_HEAP_HAS_EXEC_HEAP, which IDF disables whenever
# memory protection (PMP/PMS W^X) is on. A JIT fundamentally needs writable-then-executable
# memory, so disable memprot (which enables the exec heap). Same configuration as the other
# S3 images; safety for scripted code is the staged bounds/watchdog checks, not the
# hardware W^X wall.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_HEAP_HAS_EXEC_HEAP=y
