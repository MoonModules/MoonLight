# ESP32-S3-N16R8 (16 MB flash, 8 MB PSRAM)
# Append to sdkconfig.defaults or copy as sdkconfig.defaults

# Custom partition table: shared 16 MB layout (app0/app1 = 4 MB each, spiffs
# ~7.9 MB). Chip-independent flash map; same file for classic-16mb and P4-NANO.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/ota_16mb.csv"

# Flash size override (default is 2MB on ESP32-S3)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM, at the 80 MHz the module is rated for rather than IDF's 40 MHz default; the perf scenarios' tick did not move with it on the testbench S3 (2026-10-13), the render path running from internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# MoonLive native codegen needs an executable heap (allocExec → MALLOC_CAP_EXEC IRAM).
# MALLOC_CAP_EXEC is gated behind CONFIG_HEAP_HAS_EXEC_HEAP, which IDF disables whenever
# memory protection (PMP/PMS W^X) is on, the same write-XOR-execute rule we handle on
# macOS. A JIT fundamentally needs writable-then-executable memory, so disable memprot
# (which enables the exec heap). This is the standard ESP32-JIT configuration (ESPLiveScript
# runs the same way); the safety story for scripted code is the staged bounds/watchdog
# checks, not the hardware W^X wall.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_HEAP_HAS_EXEC_HEAP=y

# A MIDI desk on the board's own USB port: the MIDI service's USB source.
CONFIG_MM_USB_MIDI_HOST=y
# Through a powered hub, since a desk such as the APC40 takes its power from USB and the board's port supplies none.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Quad I/O flash reads: the module's flash takes four data lines, and code fetched from flash over two (DIO, the IDF default) cost the S3 16% of its tick, measured on the testbench S3 (2026-10-13).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
