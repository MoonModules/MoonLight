{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$CLAUDE_PROJECT_DIR/moondeck/check/hook_written.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$CLAUDE_PROJECT_DIR/moondeck/check/hook_written.py\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
