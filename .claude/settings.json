{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$CLAUDE_PROJECT_DIR/moondeck/check/hook_written.py\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
