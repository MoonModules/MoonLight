// Particle fountain: sparks thrown up from the floor, arcing over and falling back, after hpwit's multi_effect_controller.

class ParticleFountainEffect {
  byte amount = 6;
  byte lift = 140;

  int dimensions() { return 2; }

  string tags() { return "💫✨"; }

  void defineControls() {
    pool(300);
    addControl("amount", amount, 1, 20); // sparks per frame
    addControl("lift", lift, 40, 255); // how high the sparks are thrown
  }

  void tick() {
    fade(48);
    emit(width / 2, height - 1, 45056 + random16(8192), lift * height / 4, amount, 120, random16(256));
    gravity(height * 3);
    drag(2);
    step();
    age(1);
    render(120);
  }
}
