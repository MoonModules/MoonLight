// Twinkling stars: pale lights that swell where they land and fade slowly, over the top `cover` percent of the height, after hpwit's multi_effect_controller.

class TwinkleStarsEffect {
  byte amount = 6;
  byte cover = 100;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("amount", amount, 1, 20); // how many stars catch per frame
    addControl("cover", cover, 10, 100); // how much of the height, from the top, the sky takes
  }

  void tick() {
    fade(12);
    for (int i = 0; i < amount * 4; i = i + 1) {
      addRGB(random16(max(height * cover / 100, 1)) * width + random16(width), 90, 100, 160);
    }
  }
}
