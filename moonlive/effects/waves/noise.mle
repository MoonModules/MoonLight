// Perlin-style value noise colored by the palette.

class NoiseEffect {
  byte speed = 20;
  byte zoom = 8;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("speed", speed, 1, 120); // how fast the field drifts
    addControl("zoom", zoom, 1, 32); // how large the features are
  }

  void tick() {
    for (int y = 0; y < height; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        setPaletteColor(x, y, noise(x * zoom, y * zoom, scale(t, speed * 280)), 255);
      }
    }
  }
}
