// Octopus: a rotating spiral drawn from each pixel's POLAR position rather than its x/y. The arms

class OctopusEffect {
  byte speed = 20;
  byte branches = 4;

  int dimensions() { return 2; }

  string tags() { return "💫🖌️"; }

  void defineControls() {
    addControl("speed", speed, 1, 120); // how fast the arms rotate
    addControl("branches", branches, 1, 8); // how many arms
  }

  void tick() {
    int cx = scale(32768, width);
    int cy = scale(32768, height);

    for (int y = 0; y < height; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        setPaletteColor(x, y,
                        polarR(x - cx, y - cy) * 8 + scale(beat(speed, t), 256),
                        scale(sin(polarA(x - cx, y - cy) * branches
                                  + polarR(x - cx, y - cy) * 1024
                                  + beat(speed, t)), 256));
      }
    }
  }
}
