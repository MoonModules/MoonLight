// Plasma: two travelling sine waves summed per cell, in the demoscene shape.

class PlasmaEffect {
  byte bpm = 12;
  byte zoom = 24;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 120); // how fast the waves travel
    addControl("zoom", zoom, 1, 64); // how large the features are
  }

  void tick() {
    for (int y = 0; y < height; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        setRGB(y * width + x,
               scale(sin(x * zoom * 8 + beat(bpm, t)), 256),
               scale(sin(y * zoom * 8 + beat(bpm, t)), 256),
               scale(cos((x + y) * zoom * 4 + beat(bpm, t)), 256));
      }
    }
  }
}
