// Metal: blobs of liquid mercury that MELT into each other instead of overlapping.

class MetalEffect {
  byte bpm = 14;
  byte blend = 40;
  byte glow = 30;

  int dimensions() { return 2; }

  string tags() { return "💫🖌️"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 60); // how fast the blobs drift
    addControl("blend", blend, 0, 120); // how softly they melt together
    addControl("glow", glow, 4, 120); // halo around each blob
  }

  void tick() {
    for (int y = 0; y < height; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        fixed ux = uvX(x, width, height);
        fixed uy = uvY(y, width, height);

        fixed cx = ux - toFixed(beatsin(bpm, t, 30000) - 15000) / 25000;
        fixed cy = uy - toFixed(beatsin(bpm + 5, t, 30000) - 15000) / 25000;
        int d = polarR(toInt(cx * 1024), toInt(cy * 1024)) - 358;

        cx = ux - toFixed(beatsin(bpm + 3, t, 30000) - 15000) / 25000;
        d = smin(d, polarR(toInt(cx * 1024), toInt(uy * 1024)) - 307, blend);

        cy = uy - toFixed(beatsin(bpm + 7, t, 30000) - 15000) / 25000;
        d = smin(d, polarR(toInt(ux * 1024), toInt(cy * 1024)) - 307, blend);

        if (d < 0) { setPaletteColor(x, y, 0, 255); }
        else { setPaletteColor(x, y, scale(d * 128, 256),
                               scale(smoothstep(0, glow * 8, glow * 8 - d), 256)); }
      }
    }
  }
}
