// Fractal: the Mandelbrot and Julia sets, escape-time rendered.

class FractalEffect {
  byte bpm = 6;
  byte iters = 40;
  byte zoom = 34;
  byte seed = 128;

  int dimensions() { return 2; }

  string tags() { return "💫🖌️"; }

  void defineControls() {
    addControl("bpm", bpm, 0, 30); // how fast the Julia seed travels
    addControl("iters", iters, 8, 64); // escape-time iterations per pixel
    addControl("zoom", zoom, 12, 40); // how far into the set to look
    addControl("seed", seed, 0, 128); // 0 holds the still Mandelbrot set
  }

  void tick() {
    fixed jx = (toFixed(cos(beat(bpm, t)) - 32768) / 2560 * toFixed(seed) / 3277
        - toFixed(cos(beat(bpm, t) * 2) - 32768) / 5120 * toFixed(seed) / 3277)
       * toFixed(870 + noise(t / 4, 0, 0)) / 1000;
    fixed jy = (toFixed(sin(beat(bpm, t)) - 32768) / 2560 * toFixed(seed) / 3277
        - toFixed(sin(beat(bpm, t) * 2) - 32768) / 5120 * toFixed(seed) / 3277)
       * toFixed(870 + noise(t / 4, 0, 0)) / 1000;

    for (int y = 0; y < height; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        fixed cx = uvX(x, width, height) * toFixed(zoom) / 40;
        if (seed == 0) { cx = cx - 0.55; }

        int n = escape(cx, uvY(y, width, height) * toFixed(zoom) / 40, jx, jy, iters);

        if (n == 0) { setPaletteColor(x, y, 0, 255); }   // inside the set
        else { setPaletteColor(x, y, n, 255); }
      }
    }
  }
}
