// A red column and a green row sweeping the grid, each drawn as ONE line() call.

class LinesEffect {
  byte bpm = 30;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 240); // how fast the cross sweeps
  }

  void tick() {
    fill(0, 0, 0);

    line(scale(beat(bpm, t), width), 0,
         scale(beat(bpm, t), width), height - 1,
         255, 0, 0);

    line(0,         scale(beat(bpm, t), height),
         width - 1, scale(beat(bpm, t), height),
         0, 255, 0);
  }
}
