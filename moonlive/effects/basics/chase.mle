// Chase: a band of color running along the strand, the effect a strip owner reaches for daily.

class ChaseEffect {
  byte bpm = 20;
  byte spread = 8;
  byte tail = 180;
  byte hue = 0;

  int head = 0; // where the band's front sits now

  int dimensions() { return 3; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 240); // how fast the band runs
    addControl("spread", spread, 1, 60); // lights between one head and the next
    addControl("tail", tail, 0, 255); // how quickly the tail fades
    addControl("hue", hue, 0, 255); // palette position of the band
  }

  void tick() {
    fill(0, 0, 0);
    int n = width * height * depth;
    head = scale(beat(bpm, t), n);
    for (int i = 0; i < n; i = i + 1) {
      int d = head - i;
      if (d < 0) { d = d + n; }
      if (d < spread) {
        int bri = 255 - div(d * tail, spread);
        setRGB(i, paletteRGB(hue + d, bri));
      }
    }
  }
}
