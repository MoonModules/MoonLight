// Crosshair: a sight sweeping the grid, drawn by functions the script defines for itself.

class CrosshairEffect {
  byte bpm = 30;
  byte spread = 3;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 240); // how fast the sight sweeps
    addControl("spread", spread, 0, 20); // how thick the lines are
  }

  // The vertical line of the sight.
  void column(int cx) {
    for (int y = 0; y < height; y = y + 1) { setRGB(y * width + cx, 200, 30, 0); }
  }

  // The horizontal one.
  void row(int cy) {
    for (int x = 0; x < width; x = x + 1) { setRGB(cy * width + x, 0, 90, 200); }
  }

  // The bright cross where the two lines meet, `spread` lights along each arm.
  void center(int cx, int cy) {
    for (int i = 0; i < spread + spread + 1; i = i + 1) {
      int d = i - spread;
      if (cx + d >= 0) { if (cx + d < width) { setRGB(cy * width + cx + d, 255, 255, 255); } }
      if (cy + d >= 0) { if (cy + d < height) { setRGB((cy + d) * width + cx, 255, 255, 255); } }
    }
  }

  void tick() {
    fill(0, 0, 0);
    int cx = scale(beat(bpm, t), width);
    int cy = scale(beat(bpm + 7, t), height);
    column(cx);
    row(cy);
    center(cx, cy);
  }
}
