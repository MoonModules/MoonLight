// Breathe: the whole rig rising and falling on one slow sine, in palette color.

class BreatheEffect {
  byte bpm = 8;
  byte hue = 0;
  byte drift = 20;
  byte floorBri = 20;

  int dimensions() { return 1; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 60); // breaths per minute
    addControl("hue", hue, 0, 255); // where in the palette it sits
    addControl("drift", drift, 0, 255); // how far the color wanders per breath
    addControl("floorBri", floorBri, 0, 200); // never darker than this
  }

  void tick() {
    int bri = floorBri + div(beatsin(bpm, t, 255) * (255 - floorBri), 255);
    int p = hue + scale(beat(div(bpm, 2) + 1, t), drift + 1);
    fill(paletteRGB(p, bri));
  }
}
