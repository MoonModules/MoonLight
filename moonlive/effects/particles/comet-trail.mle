// Comet: a head flying a lissajous path, shedding sparks that become its trail.

class CometTrailEffect {
  byte speed = 30;
  byte spread = 40;
  byte sparks = 3;

  int dimensions() { return 2; }

  string tags() { return "💫✨"; }

  void defineControls() {
    pool(400);
    addControl("speed", speed, 4, 120); // how fast the comet flies
    addControl("spread", spread, 0, 200); // how far the tail spreads
    addControl("sparks", sparks, 1, 10); // sparks thrown per frame
  }

  void tick() {
    fade(28);

    int hx = scale(beatsin(speed, t, 65535), width);
    int hy = scale(beatsin(speed + 7, t, 65535), height);

    emit(hx, hy, beat(speed + 3, t), spread * 4, sparks, 90, scale(beat(6, t), 256));

    drag(6);
    step();
    age(2);
    render(90);

    setPaletteColor(hx, hy, scale(beat(6, t), 256), 255);
  }
}
