// Bouncing balls: four balls on their own paths, each reversing at every wall.

class BallsEffect {
  byte count = 4;
  byte size = 5;
  byte bpm = 20;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("count", count, 1, 4); // how many balls bounce
    addControl("size", size, 1, 10); // ball size as a share of the grid
    addControl("bpm", bpm, 1, 120); // how fast they travel
  }

  // One ball: a filled disc at (px, py), shaded from its center outward.
  void drawBall(int px, int py, int radius, int hue) {
    for (int dy = 0; dy < 21; dy = dy + 1) {
      for (int dx = 0; dx < 21; dx = dx + 1) {
        int away = (dx - radius) * (dx - radius) + (dy - radius) * (dy - radius);
        if (away <= radius * radius) {
          setPaletteColor(px + dx, py + dy, hue, 255 - scale(away * 640, 256));
        }
      }
    }
  }

  void tick() {
    fill(0, 0, 0);

    int radius = scale(height, size * 819) + 1;
    if (width < height) { radius = scale(width, size * 819) + 1; }
    if (radius > 10) { radius = 10; }
    if (width < radius * 2 + 2) { radius = 0; }
    if (height < radius * 2 + 2) { radius = 0; }

    for (int i = 0; i < count; i = i + 1) {
      drawBall(beatsin(bpm + i * 7, t, width - radius * 2 - 1),
               beatsin(bpm + i * 5 + 3, t, height - radius * 2 - 1),
               radius, i * 64);
    }
  }
}
