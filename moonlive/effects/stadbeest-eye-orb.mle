// StadBeestEyeOrb: the legs' orb seen through the eye. The disc is a window onto the same floating shape, scaled so its height spans the legs, lit where the shape's shell crosses it: a tilted disc that wobbles as it turns, a ball, an egg. The eye blinks.

class StadBeestEyeOrbEffect {
  byte speed = 40;
  byte spin = 60;
  byte tilt = 90;
  byte shape = 0;
  byte morph = 30;
  byte size = 60;
  byte solid = 40;

  int nx = 0;    // the shape's axis, in 32768ths
  int ny = 32767;
  int nz = 0;
  int h = 0;     // the height of its center, in lights of the legs
  int aa = 1;    // its width squared
  int bb = 1;    // its height along the axis squared
  int rise = 0;  // how far it has risen and fallen, in 1280ths of a sine step so a slow speed still moves
  int lastT = 0; // the time of the last frame, so a speed change carries on from where it is
  int blinkAt = 3000; // when the next blink starts, in ms

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("speed", speed, 0, 255); // how fast the shape rises and falls
    addControl("spin", spin, 0, 255); // how fast its tilt turns
    addControl("tilt", tilt, 0, 255); // how far the shape leans, up to a quarter turn
    addSelect("shape", shape, "disc|ball|egg"); // the shape it holds while morph is 0
    addControl("morph", morph, 0, 255); // how fast it changes between disc, ball and egg by itself
    addControl("size", size, 1, 255); // its width, in lights of the legs
    addControl("solid", solid, 0, 255); // how bright its inside is, 0 for a hollow shell
  }

  // How far the lids are closed, in lights from the middle: a blink closes and opens within 300 ms, every few seconds.
  int lids() {
    if (t > blinkAt + 300) { blinkAt = t + 1000 + random16(2000) * 3; }
    int closing = 150 - polarR(t - blinkAt - 150, 0);
    closing = div(closing + polarR(closing, 0), 2);
    return div(closing * div(height, 2), 150);
  }

  void tick() {
    fill(0, 0, 0);
    // The same shape as the legs' orb, from the same controls: disc, ball or egg, its height along the axis as a share of its width.
    int s = shape * 128;
    if (s > 255) { s = 255; }
    if (morph > 0) { s = div(sin(div(t * morph, 64)), 256); }
    int b = 3 + div((size - 3) * s, 128);
    if (s > 128) { b = size + div(size * (s - 128), 200); }
    aa = size * size;
    bb = b * b;

    // Its axis leans by `tilt`, and the lean turns.
    int lean = div(tilt * 16384, 255);
    int turnA = div(t * spin, 16);
    nx = div((sin(lean) - 32768) * (cos(turnA) - 32768), 32768);
    nz = div((sin(lean) - 32768) * (sin(turnA) - 32768), 32768);
    ny = cos(lean) - 32768;

    // It rises and falls through the legs' whole height, squared so the low end stays slow to set.
    rise = mod(rise + (t - lastT) * speed * speed, 65536 * 1280);
    lastT = t;
    h = div(143 * sin(div(rise, 1280)), 65535);

    int cx = div(width, 2);
    for (int y = 0; y < height; y = y + 1) {
      // Each light of the disc stands for 144 / height lights of the legs, whose height is 144, in the plane through the ring's middle.
      int dy = div(y * 144, height) - h;
      for (int x = 0; x < width; x = x + 1) {
        int dx = div((x - cx) * 144, height);
        // Along the axis, and the squared distance from it.
        int u = div(nx * dx + ny * dy, 32768);
        int rho = div(u * u * 256, bb) + div((dx * dx + dy * dy - u * u) * 256, aa);
        int d = rho - 256;
        if (d < 0) { d = 0 - d; }
        int bright = 255 - div(d * 255, 48);
        if (rho < 256) {
          if (bright < solid) { bright = solid; }
        }
        if (bright > 0) { setPaletteColor(x, y, mod(div(polarA(dx, dy), 256) + div(t, 40) + div(y * 64, height), 256), bright); }
      }
    }
    // The lids, over what is drawn: the rows beyond the opening go dark.
    int closed = lids();
    for (int y = 0; y < closed; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        setRGB(y * width + x, 0, 0, 0);
        setRGB((height - 1 - y) * width + x, 0, 0, 0);
      }
    }
  }
}
