// Sparkle: lights flickering on at random and fading out, like sun on water.

class SparkleEffect {
  byte density = 6;
  byte fadeAmt = 40;
  byte hueSpread = 255;

  int dimensions() { return 3; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("density", density, 1, 40); // how many lights catch per frame
    addControl("fadeAmt", fadeAmt, 1, 120); // how fast a spark dies
    addControl("hueSpread", hueSpread, 0, 255); // how much of the palette the sparks use
  }

  void tick() {
    fade(fadeAmt);
    int n = width * height * depth;
    for (int i = 0; i < density; i = i + 1) {
      int p = min(random16(256), hueSpread);
      setRGB(random16(n), paletteRGB(p, 255));
    }
  }
}
