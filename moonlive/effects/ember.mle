// Ember: a fire that simulates rather than draws. Each cell holds a heat value that decays and

class EmberEffect {
  byte  cool = 30;
  byte  spark = 60;
  byte  cycle = 20;
  byte  heat[16];

  int dimensions() { return 1; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("cool", cool, 1, 120); // how fast a cell loses heat
    addControl("spark", spark, 0, 200); // how fiercely new embers catch
    addControl("cycle", cycle, 1, 120); // how often the fire re-ignites
  }

  void tick() {
    for (int i = 0; i < 16; i = i + 1) {
      heat[i] = max(heat[i] - cool, 0);
    }

    for (int j = 0; j < 16; j = j + 1) {
      if (random16(256) < scale(spark, 65535 - beat(cycle, t))) { heat[j] = 255; }
    }

    for (int k = 0; k < 16; k = k + 1) {
      setRGB(k, paletteRGB(heat[k], heat[k]));
    }
  }
}
