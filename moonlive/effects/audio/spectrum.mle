// Spectrum: the room's frequency bands as bars, bass on the left and treble on the right.

class SpectrumEffect {
  byte gain = 100;
  byte fadeAmt = 60;
  byte peakHold = 1;

  int dimensions() { return 2; }

  string tags() { return "💫🎶"; }

  void defineControls() {
    addControl("gain", gain, 10, 255); // how hard the bands are driven
    addControl("fadeAmt", fadeAmt, 1, 200); // how fast a bar falls back
    addControl("peakHold", peakHold, 0, 1); // cap each bar with a bright peak
  }

  void tick() {
    fade(fadeAmt);

    int bars = width;
    if (width < 2) { bars = height; }
    for (int x = 0; x < bars; x = x + 1) {
      int b = div(x * 16, bars);
      int mag = min(div(audioBand(b) * gain, 100), 255);
      RGB c = paletteRGB(b * 16, 255);
      if (width < 2) { setRGB(x, div(c.r * mag, 255), div(c.g * mag, 255), div(c.b * mag, 255)); }
      int top = div(mag * height, 256);
      if (width < 2) { top = 0; }
      for (int y = 0; y < top; y = y + 1) {
        setRGB((height - 1 - y) * width + x, c);
      }
      if (peakHold && top > 0) { setRGB((height - top) * width + x, 255, 255, 255); }
    }
  }
}
