// Troy: a tight sweep on the beat, with the gobo wheel rolling on the bass.

class TroyEffect {
  byte bpm = 30;
  byte pan = 175;
  byte tilt = 90;
  byte range = 20;
  byte gobo = 0;
  byte cutin = 200;

  int dimensions() { return 1; }

  string tags() { return "🗼🎶🎯"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 120); // how fast the heads swing
    addControl("pan", pan, 0, 255); // where the sideways swing is centered
    addControl("tilt", tilt, 0, 255); // where the vertical swing is centered
    addControl("range", range, 0, 127); // how far either swing travels
    addControl("gobo", gobo, 0, 255); // the pattern the wheel holds between rolls
    addControl("cutin", cutin, 0, 255); // how loud the bass has to be to open the beam
  }

  void tick() {
    int bass = audioBand(0);
    for (int i = 0; i < height; i = i + 1) {
      int p = beatsin(bpm, t, 255);
      int q = beatsin(bpm, t, 255);
      if (mod(i, 2) == 0) {
        p = 255 - p;
        q = 255 - q;
      }
      setPan(i, pan - range + div((p * range * 2), 255));
      setTilt(i, tilt - range + div((q * range * 2), 255));
      setGobo(i, gobo);
      if (bass > cutin) { setZoom(i, 255); } else { setZoom(i, 0); }
      setRGB(i, audioBand(15), audioBand(7), bass);
    }
  }
}
