// StadBeestAutopilot: runs the StadBeest unattended. Every few minutes a new scene moves on to the next look (walking, the orb, the thrusters) and picks a palette (stadbeest-fire in a third of the thruster scenes), a mood, how much the music counts and whether it flashes on the beat; within a scene the energy breathes once a minute. It moves the control surface, so the legs follow here and the eyes over OSC, each on the look's own controls through automap.

class StadBeestAutopilot {
  bool run = true;
  byte seconds = 180;

  int scene = -1;          // the scene running, counted from boot
  int sceneAt = -1000000;  // when it started, in ms, so a new length moves where it ends rather than restarting the count
  int look = 0;            // the scene's look: 0 walking, 1 the orb, 2 the thrusters, one switch each
  int mood = 128;          // the scene's energy, 0 calm to 255 wild
  int palette = 0;         // the scene's palette
  int pulseOn = 0;         // whether the scene flashes on the beat
  int hearing = 160;       // how much the music drives legs and eyes this scene
  int lastGlide = -100000; // when the slots were last written, in ms
  int nextSlot = 7;        // the slot written next; 7 means all are written

  void defineControls() {
    addControl("run", run, 0, 1); // off hands the beast back to people and desks
    addControl("seconds", seconds, 1, 255); // how long a scene lasts
  }

  // The energy around the scene's mood, breathing once a minute.
  int energy() {
    int phase = div(mod(t, 60000) * 1092, 1000);
    int e = mood + div((sin(phase) - 32768) * 48, 32768);
    if (e < 0) { e = 0; }
    if (e > 255) { e = 255; }
    return e;
  }

  // One slot per call: the look first, so automap has moved the desk to it before the rest lands, then the slots every look shares: the palette, pulse, bpm with the energy, and sensitivity.
  void write(int k) {
    // The look's own switch on, the other two off.
    int on = 0;
    if (k == look) { on = 1; }
    if (k == 0) { setControl("switch3", on); }
    if (k == 1) { setControl("switch4", on); }
    if (k == 2) { setControl("switch5", on); }
    if (k == 3) { setControl("encoder1", palette); }
    if (k == 4) { setControl("switch2", pulseOn); }
    if (k == 5) { setControl("fader2", 20 + div(energy() * 70, 255)); }
    if (k == 6) { if (look != 1) { setControl("fader3", hearing); } } // the orb hears no music, and its fader3 is its spin
  }

  void tick20ms() {
    if (run == 0) { return; }
    if (t - sceneAt >= seconds * 1000) {
      scene = scene + 1;
      sceneAt = t;
      look = mod(scene, 3);
      palette = random16(60); // any built-in palette
      if (look == 2) { if (random16(3) == 0) { palette = 64; } } // a third of the thruster scenes burn in stadbeest-fire, its place in the palette list on every device
      mood = random16(256);
      pulseOn = random16(2);
      hearing = 80 + random16(150);
      lastGlide = -100000;
    }
    // Every ten seconds all seven slots, one per tick: the eyes hear them over WiFi multicast, which drops a burst.
    if (t - lastGlide >= 10000) {
      lastGlide = t;
      nextSlot = 0;
    }
    if (nextSlot < 7) {
      write(nextSlot);
      nextSlot = nextSlot + 1;
    }
  }
}
